# Copy to .env and adjust as needed:
#   cp .env.example .env

APP_NAME=Vacation Tracker
APP_ENV=development
LOG_LEVEL=INFO

POSTGRES_USER=example
POSTGRES_PASSWORD=
POSTGRES_DB=example

# Required for the application / Alembic / scripts that use the DB
DATABASE_URL=postgresql+psycopg://example:example@localhost:5432/example

# Required only when running: uv run python scripts/create_admin.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
