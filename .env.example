# Copy to .env and adjust as needed:
#   cp .env.example .env

APP_NAME=Vacation Tracker
APP_ENV=development
LOG_LEVEL=INFO

# Required for the application / Alembic / scripts that use the DB
DATABASE_URL=postgresql+psycopg://vacation:vacation@localhost:5432/vacation_tracker

# Required only when running: uv run python scripts/create_admin.py
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
